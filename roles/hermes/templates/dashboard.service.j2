[Unit]
Description=Hermes Agent Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=debian
Group=debian
ExecStart=/home/debian/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main dashboard --host {{ _dashboard_host }} --port {{ hermes_dashboard_port }} --no-open
WorkingDirectory=/home/debian/.hermes/hermes-agent
Environment="HOME=/home/debian"
Environment="USER=debian"
Environment="LOGNAME=debian"
Environment="PATH=/home/debian/.hermes/hermes-agent/venv/bin:/home/debian/.hermes/hermes-agent/node_modules/.bin:/usr/bin:/home/debian/.local/bin:/home/debian/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/debian/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/debian/.hermes"
Restart=on-failure
RestartSec=30
RestartForceExitStatus=75
KillMode=mixed
ExecReload=/bin/kill -USR1 $MAINPID
StandardError=journal

[Install]
WantedBy=multi-user.target